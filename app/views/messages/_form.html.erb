<%# We cant use this syntax: data-controller="spin" bc its HTML%>
<%# data-action='submit->spin#start' %>
<%# we are writing ruby to generate html: %>
<%= simple_form_for [chat, message], html: { data: { controller: 'spin', action: 'submit->spin#start' } } do |f| %>
  <%= f.input :content, placeholder: "Ask a question", required: true, label: false, wrapper_html: { class: 'flex-grow-1', style: 'margin-bottom: 0 !important' } %>
  <%= f.button :submit, 'Ask LLM', class: 'btn btn-primary' %>
<% end %>

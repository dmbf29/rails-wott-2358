<%# messages is the ID of the div i want to append to %>
<%= turbo_stream.append "messages" do %>
  <%# I am putting this HTML partial inside of that div i targeted %>
  <%= render 'messages/message', message: @message %>
  <%# Then insert the ai message from the controller %>
  <%= render 'messages/message', message: @ai_message %>
<% end %>
<%# messages is the ID of the div i want to update %>
<%= turbo_stream.update 'new_message' do %>
  <%= render "messages/form", chat: @chat, message: Message.new %>
<% end %>
